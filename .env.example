# ---------------------------------------------------------------------------
# Mazzaق environment
# Local development uses embedded Postgres (PGlite) when DATABASE_URL is empty.
# ---------------------------------------------------------------------------

# Production Postgres connection (e.g. Neon via the Vercel Marketplace). Leave
# empty for zero-setup local development. On Vercel use the pooled URL.
# DATABASE_URL=postgres://user:password@host:5432/mazzaq

# PGlite storage folder for local development.
PGLITE_DATA_DIR=.data/pglite

# Public URL of the site. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string
REQUIRE_EMAIL_VERIFICATION=false

# Email delivery. If RESEND_API_KEY is empty, messages are written to the
# admin outbox at /en/admin/outbox instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Mazzaق <orders@mazzaq.co>

# Bootstrap admin account. CHANGE THESE before deploying anywhere real.
ADMIN_EMAIL=admin@mazzaq.co
ADMIN_PASSWORD=change-me
ADMIN_NAME=Mazzaق Admin

# Local development helpers
AUTO_MIGRATE=true
AUTO_SEED=true
